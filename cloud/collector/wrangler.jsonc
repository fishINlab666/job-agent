{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobagent-public-observation",
  "main": "src/main.py",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["python_workers"],
  "triggers": {
    // 飞书门户拒绝 Cloudflare 机房请求；五源远端试采通过前保持暂停。
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobagent-public-observation",
      "database_id": "3c22c46d-46b4-4fda-bf4d-53894186488b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
