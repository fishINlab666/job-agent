# 个人信息，绝对不提交
profile.yaml
# 备份/临时副本也算个人信息。只写 profile.yaml 一行挡不住 profile.yaml.bak
# —— 编辑器和手改配置常留这些后缀，而这个文件里是真实姓名手机号。
profile.yaml.*
!profile.yaml.example
*.bak
*.orig
*~

# 本地数据
data/
*.db
*.db-wal
*.db-shm

# 浏览器登录态（含 cookie，能直接登进招聘账号）。
# 写成通配是因为 --user-data-dir 的值是自由的：一开始只写了 .browser-profile/，
# 而实际用起来传的是 .browser —— 160MB 的登录态就那么躺在未忽略状态里。
# 目录名由命令行决定，判据就不该写死一个。
.browser*/
*/.browser*/

# 投递证据截图。里面是填好的真实表单——姓名、手机号、邮箱都在画面里，
# 而且是图片，扫不出来也 diff 不出来，只能靠这一行挡。
screenshots/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store
